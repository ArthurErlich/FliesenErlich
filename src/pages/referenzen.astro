---
import Layout from '../layouts/Layout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Headline from '../components/Headline.astro';
import Paragraph from '../components/Paragraph.astro';

const groups = [
	{
		title: 'Für Privatpersonen',
		desc: 'Vom kleinen Küchen-Update bis zur kompletten Badsanierung – in allen erdenklichen Farben und Oberflächen.',
	},
	{
		title: 'Für Individualisten',
		desc: 'Auch ausgefallene Projekte wie der Umbau von Hallen oder ungenutzten Gebäuden zu Wohnraum – mit Fliesen als gestalterisches Mittel für Atmosphäre und Funktion.',
	},
	{
		title: 'Für Architekten',
		desc: 'Zuverlässiger Ausführungspartner für Fliesenarbeiten, inklusive Estrichlieferung und Untergrundvorbereitung.',
	},
];
---

<Layout
	title="Referenzen"
	description="Ausgewählte Projekte von Erlich Fliesen">
	<Section>
		<Container>
			<span
				class="text-xs font-semibold tracking-widest text-accent uppercase"
				>Referenzen</span
			>
			<Headline level={1}>Ausgewählte Projekte</Headline>
			<Paragraph class="max-w-md">
				Fliesenlegen ist mehr als Verlegen: Beratung, Raumplanung und
				die richtige Untergrundvorbereitung entscheiden über das
				Ergebnis.
			</Paragraph>
			<div class="mt-12 grid gap-6 sm:grid-cols-3">
				{
					groups.map((g) => (
						<div class="bg-white p-6">
							<Headline level={2}>{g.title}</Headline>
							<Paragraph>{g.desc}</Paragraph>
						</div>
					))
				}
			</div>
		</Container>
	</Section>
</Layout>
