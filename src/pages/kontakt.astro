---
import Layout from '../layouts/Layout.astro';
import Section from '../components/layout/Section.astro';
import Link from '../components/Link.astro';
import CapWidget from '../components/CapWidget.astro';
import TextField from '../components/form/TextField.astro';
import TextArea from '../components/form/TextArea.astro';
import Checkbox from '../components/form/Checkbox.astro';
import Button from '../components/form/Button.astro';
import { contact } from '../consts';
---

<Layout title="Kontakt" description="Kontaktieren Sie Erlich Fliesen">
	<Section class="px-8 md:px-16">
		<div class="grid gap-10 md:grid-cols-12">
			<div class="md:col-span-5">
				<span class="text-xs font-semibold tracking-widest text-accent uppercase">Kontakt</span>
				<h1 class="my-5 font-display text-4xl leading-[1.05] tracking-[-0.02em] text-default">
					Sprechen Sie<br />mit uns
				</h1>
				<p class="max-w-xs text-sm leading-relaxed text-black/60">
					Rufen Sie uns an oder schreiben Sie uns eine E-Mail – wir melden uns zeitnah zurück.
				</p>
				<div class="mt-10 space-y-2 text-sm leading-relaxed text-black/70">
					<div>{contact.owner}</div>
					<div>{contact.street}, {contact.city}</div>
					<div>
						Telefon: <a class="underline" href={`tel:${contact.phone.replace(/\s/g, '')}`}
							>{contact.phone}</a
						>
					</div>
					<div>
						E-Mail: <a class="underline" href={`mailto:${contact.email}`}>{contact.email}</a>
					</div>
					<div>Erreichbarkeit: {contact.hours}</div>
				</div>
			</div>

			<div class="border-accent/30 md:col-span-7 md:border-l md:pl-10">
				<form id="kontakt-form" class="space-y-8" novalidate>
					<div class="grid grid-cols-2 gap-4">
						<TextField id="k-first" name="firstName" label="Vorname" required autocomplete="given-name" />
						<TextField id="k-last" name="lastName" label="Nachname" required autocomplete="family-name" />
					</div>
					<TextField id="k-email" name="email" label="E-Mail" type="email" required autocomplete="email" />
					<TextArea id="k-message" name="message" label="Nachricht" required maxlength={2500} rows={6} />
					<CapWidget />
					<Checkbox id="k-consent" name="consent" required>
						Ich habe die <Link href="/datenschutz/" class="underline">Datenschutzerklärung</Link> gelesen. *
					</Checkbox>
					<Button type="submit">Anfrage senden</Button>
					<p id="kontakt-form-error" class="hidden text-sm text-default" role="alert">
						Ihre Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es später erneut oder
						schreiben Sie uns direkt an <a class="underline" href={`mailto:${contact.email}`}>{contact.email}</a>.
					</p>
				</form>
				<div id="kontakt-form-success" class="hidden space-y-2" role="status">
					<h2 class="font-serif text-xl font-semibold text-default">Vielen Dank für Ihre Anfrage!</h2>
					<p class="text-sm leading-relaxed text-black/70">
						Wir haben Ihre Nachricht erhalten und melden uns {contact.hours} bei Ihnen zurück.
					</p>
				</div>
			</div>
		</div>
	</Section>
</Layout>

<script>
	import { wireFormValidation } from '../scripts/form-validation';

	const form = document.getElementById('kontakt-form') as HTMLFormElement | null;
	const errorBox = document.getElementById('kontakt-form-error');
	const successBox = document.getElementById('kontakt-form-success');
	if (form) {
		const { validateOnSubmit } = wireFormValidation(form);

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			errorBox?.classList.add('hidden');
			if (!validateOnSubmit()) return;

			try {
				// TODO(#47): /api/contact.php doesn't exist yet — this will 404
				// until the PHP backend handler (wayfinder ticket #47) is built.
				const res = await fetch('/api/contact.php', { method: 'POST', body: new FormData(form) });
				if (!res.ok) throw new Error(`Request failed: ${res.status}`);
				form.hidden = true;
				successBox?.classList.remove('hidden');
			} catch {
				errorBox?.classList.remove('hidden');
			}
		});
	}
</script>
