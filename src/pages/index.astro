---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import GalleryCategories from '../components/GalleryCategories.astro';
import Headline from '../components/Headline.astro';
import Paragraph from '../components/Paragraph.astro';

const services = [
	{
		title: 'Bodenbeläge',
		desc: 'Naturstein- und Fliesenböden für Wohn- und Gewerberäume.',
	},
	{
		title: 'Mosaik',
		desc: 'Bespoke Mosaikflächen für Bäder, Pools und Fassaden.',
	},
	{
		title: 'Fassaden',
		desc: 'Wetterfeste Steinfassaden mit präziser Fugenführung.',
	},
	{
		title: 'Beratung',
		desc: 'Materialwahl und Planung direkt in unserer Werkstatt.',
	},
];
---

<Layout title="Startseite" description="Mosaik-, Platten- & Fliesenleger">
	<Hero />

	<Section id="ueber-uns" tone="base">
		<Container class="max-w-3xl">
			<span
				class="text-xs font-semibold tracking-widest text-accent uppercase"
				>Über uns</span
			>
			<Headline level={2} class="my-3">Fliesen Erlich</Headline>
			<Paragraph size="lead">
				Fliesen Erlich ist seit vielen Jahren die erste Adresse, wenn
				es um die Gestaltung von Wänden und Böden geht. Wir sehen uns
				nicht nur als Fliesenleger, sondern als aktive Gestalter für
				Lebensräume. Wurden Fliesen lange Zeit hauptsächlich in
				Badezimmern verlegt, so hat sich dies im Laufe der Zeit
				gewandelt: Mittlerweile finden sich Fliesen in allen
				Wohnbereichen wieder – in jeder Form und Farbe, etwa als
				Mosaik oder Platten.
			</Paragraph>
		</Container>
	</Section>

	<Section id="leistungen" tone="inset">
		<Container>
			<Headline level={2} class="mb-12">Leistungen</Headline>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					services.map((s) => (
						<div class="bg-white p-6">
							<img
								src={`https://placehold.co/400x400?text=${encodeURIComponent(s.title)}`}
								alt=""
								class="mb-6 aspect-square w-full bg-light-gray object-cover"
							/>
							<Headline level={3}>{s.title}</Headline>
							<Paragraph>{s.desc}</Paragraph>
						</div>
					))
				}
			</div>
		</Container>
	</Section>

	<Section id="referenzen" tone="base">
		<Container class="mb-12">
			<span
				class="text-xs font-semibold tracking-widest text-accent uppercase"
				>Referenzen</span
			>
			<Headline level={2} class="my-3">Ausgewählte Projekte</Headline>
		</Container>
	</Section>
	<GalleryCategories />
</Layout>
