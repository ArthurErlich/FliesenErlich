---
import { Image } from 'astro:assets';
import logo from '../assets/coperated/logo-erlich-dunkel.png';
import { navLinks } from '../consts';
import Link from './Link.astro';
---

<div class="z-10 bg-white shadow-md md:sticky md:top-0 md:left-0">
	<section class="flex justify-start gap-10">
		<a
			class="block cursor-pointer py-1"
			href="/"
			title="Fliesen Erlich Logo">
			<Image
				src={logo}
				alt="Fliesen Erlich Logo"
				class="h-15 w-auto object-contain pl-5"
			/>
		</a>
		<address
			class="hidden grow flex-wrap items-center justify-end pr-5 not-italic md:flex">
			<div>
				<a href="tel:01634310646">Mobil: +49 (0) 1634 3106 46</a><br />
				<a href="mailto:fliesenerlich@hotmail.com"
					>E-Mail: fliesenerlich@hotmail.com</a
				>
			</div>
		</address>
	</section>
	<nav aria-label="Navigation" class="hidden md:block">
		<ul class="flex grow items-stretch justify-center gap-10 bg-default">
			{
				navLinks.map(({ href, text }) => (
					<li class="text-white">
						<Link href={href} nav class="block px-2 py-1">
							{text}
						</Link>
					</li>
				))
			}
		</ul>
	</nav>
</div>
