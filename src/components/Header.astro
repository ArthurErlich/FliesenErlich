---
import { Image } from 'astro:assets';
import Container from './layout/Container.astro';
import logo from '../assets/coperated/logo-erlich-dunkel.png';

const navLinks = [
	{ href: '/', text: 'Fliesen Erlich' },
	{ href: '/impressum', text: 'Impressum' }
];
---

<div class="bg-white shadow-md md:sticky md:top-0 md:left-0 z-10">
		<section class="flex justify-start gap-10">
			<a class="cursor-pointer py-1 block" href="/" title="Fliesen Erlich Logo">
				<Image src={logo} alt="Fliesen Erlich Logo" class="h-15 w-auto object-contain pl-5" />
			</a>
			<address class="hidden grow flex-wrap items-center justify-end not-italic md:flex pr-5">
				<div>
					<a href="tel:01634310646">Mobil: +49 (0) 1634 3106 46</a><br>
				    <a href="mailto:fliesenerlich@hotmail.com">E-Mail: fliesenerlich@hotmail.com</a>
				</div>
			</address>
		</section>
	<nav aria-label="Navigation" class="hidden md:block">
		<ul class="grow flex items-stretch justify-center gap-10 bg-default">
			{
				navLinks.map(({ href, text }) => (
					<li class="text-white">
						<a href={href}>
							<div class="px-2 py-1">{text}</div>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>
