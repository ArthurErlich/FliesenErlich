---
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	class?: string;
	/** Set on links inside a <nav> landmark — those don't get the underline treatment. */
	nav?: boolean;
	'aria-current'?: 'page';
}

const { href, class: className, nav = false, 'aria-current': ariaCurrent } = Astro.props;

const isExternal = /^https?:\/\//.test(href) && new URL(href).hostname !== Astro.site?.hostname;

const focusRing =
	'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-light)]';

const underlineSpan =
	"relative inline-block leading-none after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[1.5px] after:origin-right after:bg-[var(--link-underline-color,var(--color-light))] after:transition-transform after:duration-150 after:ease-out after:content-[''] hover:after:scale-x-0";
---

{
	isExternal ? (
		<a
			href={href}
			class={`inline-flex items-center gap-1 ${focusRing} ${className ?? ''}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-current={ariaCurrent}
		>
			{nav ? <slot /> : <span class={underlineSpan}><slot /></span>}
			<Icon name="external-link" class="size-3.5 shrink-0" />
		</a>
	) : nav ? (
		<a href={href} class={`${focusRing} ${className ?? ''}`} aria-current={ariaCurrent}>
			<slot />
		</a>
	) : (
		<a href={href} class={`${focusRing} ${className ?? ''}`} aria-current={ariaCurrent}>
			<span class={underlineSpan}>
				<slot />
			</span>
		</a>
	)
}
