{
    "useTabs": true,
    "tabWidth": 4,
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": true,
    "bracketSameLine": true,
    "trailingComma": "all",
    "plugins": [
        "@zackad/prettier-plugin-twig",
        "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "xxx"
}